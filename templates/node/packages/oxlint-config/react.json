{
  "extends": ["./base.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "env": {
    "browser": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // CSS and font imports are side effects by design.
    "import/no-unassigned-import": "off"
  }
}
