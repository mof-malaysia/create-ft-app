{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/{{scope}}/oxlint-config/react.json"],
  // FTDS files are installed by the shadcn CLI and kept as the registry ships them.
  "ignorePatterns": [
    "dist/**",
    "src/components/ui/**",
    "src/components/blocks/**",
    "src/lib/ftds/**"
  ]
}
