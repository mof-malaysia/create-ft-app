# Local settings for `pnpm dev`. Copy to .env (git-ignored); create-ft-app did
# this for you. Every variable is validated in src/env.ts.
PORT=3000
LOG_LEVEL=info
# @if postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{name}}
# @endif
# Origins allowed to call the api from another origin, comma-separated.
# CORS_ORIGIN=http://localhost:5173
